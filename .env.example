# Copy to .env for local use (never commit the real .env -- it's gitignored).
# All values below are placeholders.

# Required. The keyless service account whose identity signs the delegation
# JWT (IAM Credentials signJwt). Must have domain-wide delegation authorized
# in the Workspace Admin Console for the gmail.send scope.
GMAIL_DELEGATED_SA=audit-platform-sa-prj-dg-devop@prj-dg-devops-test.iam.gserviceaccount.com

# Required. The Workspace mailbox impersonated when sending alerts -- used
# as both the JWT `sub` claim and the Gmail API `userId`. Must hold a Gmail
# license.
GMAIL_SENDER=audit-alerts@yourdomain.example

# Optional. Display name used in the email "From" header.
GMAIL_SENDER_NAME=GCP Audit Platform

# Optional. Total attempts (including the first) for token exchange and
# Gmail send calls before giving up, with exponential backoff between them.
GMAIL_MAX_ATTEMPTS=4

# Optional. Per-request timeout, in seconds, for the token exchange HTTP call.
GMAIL_TIMEOUT=30

# --- Cloud Asset Inventory enrichment -----------------------------------

# Optional. How long (seconds) a resource's CAI lookup result is cached
# in-process before being re-fetched. Audit log bursts hit the same
# resource repeatedly; this avoids rate-limiting yourself.
CAI_CACHE_TTL_SECONDS=300

# Optional. Per-request timeout, in seconds, for the CAI search call.
CAI_TIMEOUT_SECONDS=10

# --- Gemini analysis (Vertex AI) -----------------------------------------
# Only called for findings whose matched rule sets `ai_analysis: true` in
# config/rules.yaml.

# Optional. Vertex AI project. Defaults to GOOGLE_CLOUD_PROJECT, which
# Cloud Functions sets automatically at runtime -- you usually don't need
# to set this yourself except for local testing.
VERTEX_PROJECT=prj-dg-devops-test

# Optional. Vertex AI region for Gemini calls. Deliberately independent of
# the function's own deployment region (asia-south1) -- Gemini model
# availability is regionally limited and us-central1 is broadly available.
VERTEX_LOCATION=us-central1

# Optional. Gemini model name.
GEMINI_MODEL=gemini-2.5-flash

# Optional. Caps the length of the generated analysis.
GEMINI_MAX_TOKENS=400

# Optional. Hard wall-clock timeout, in seconds, for a single Gemini call.
GEMINI_TIMEOUT=20

# --- BigQuery persistence -------------------------------------------------

# Optional. BigQuery project. Defaults to the ADC-resolved default project.
BQ_PROJECT=prj-dg-devops-test

# Optional. Dataset/table names -- must match terraform/bigquery.tf if you
# change them.
BQ_DATASET=audit_platform
BQ_TABLE=alert_events

# --- Dead-letter queue -----------------------------------------------------

# Required for DLQ delivery to actually publish anywhere; if unset,
# undeliverable findings are logged at ERROR (recoverable from Cloud
# Logging) instead of published.
DLQ_TOPIC=audit-platform-dlq

# Optional. Defaults to GOOGLE_CLOUD_PROJECT (auto-set by Cloud Functions).
DLQ_PROJECT=prj-dg-devops-test
